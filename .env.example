SECRET_KEY=replace_with_a_random_secret_key_here
# If your key has spaces, wrap it in quotes:
# SECRET_KEY="argan bhujel 017"
DATABASE_URL=sqlite:///dates.db
# For Neon/Postgres: postgresql://user:password@host/dbname?sslmode=require

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
OWNER_EMAIL=your_email@gmail.com

PAYMENT_AMOUNT=1000
PAYMENT_RECIPIENT=Your Name / Account Name
PAYMENT_QR_PATH=static/images/payment-qr.png
# Optional: direct Cloudinary (or any) URL for QR
# PAYMENT_QR_URL=https://res.cloudinary.com/your-cloud/image/upload/...

# Cloudinary (recommended for Vercel – stores QR + payment proofs in the cloud)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

FLASK_ENV=development
